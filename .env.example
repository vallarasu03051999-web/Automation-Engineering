# Copy this file to .env for local runs (`.env` is gitignored).
#
# TEST_ENV selects a layered override file: base values come from `.env`,
# then `.env.<TEST_ENV>` is applied on top for that target (see
# `.env.staging.example` for a worked example). Defaults to "local".
TEST_ENV=local

# Application under test
BASE_URL=https://opensource-demo.orangehrmlive.com

# Simulated backend used for the API cross-check steps (see README "API validation")
API_BASE_URL=https://reqres.in

# Admin credentials for the OrangeHRM demo instance
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
