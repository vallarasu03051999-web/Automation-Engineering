{
  "name": "orangehrm-employee-lifecycle-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI/API automation for the OrangeHRM Employee Lifecycle Management scenario",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --grep-invert @quarantine",
    "test:all": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:quarantine": "playwright test --grep @quarantine",
    "test:ui": "playwright test tests/employee-lifecycle.spec.ts tests/auth.spec.ts tests/role-based-access.spec.ts",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test tests/employee-lifecycle.spec.ts --headed",
    "test:debug": "playwright test --debug",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "orangehrm"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.1"
  }
}
