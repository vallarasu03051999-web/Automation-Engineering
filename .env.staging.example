# Example override layer for a hypothetical "staging" target, applied on top
# of `.env` when run with TEST_ENV=staging (see package.json's "test:staging"
# script). Copy to `.env.staging` and fill in real values if a staging
# OrangeHRM instance becomes available; only the keys that actually differ
# from `.env` need to be listed here.
BASE_URL=https://staging.example.internal
ADMIN_USERNAME=staging-admin
ADMIN_PASSWORD=replace-me
